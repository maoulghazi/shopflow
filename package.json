{
  "name": "shopflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:api": "cd api && npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "install:all": "cd frontend && npm install && cd ../api && npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "concurrently": "^8.2.0",
    "wait-on": "^9.0.4"
  }
}
